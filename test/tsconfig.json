{
   "compilerOptions": {
      "allowUnreachableCode": false,
      "lib": ["ES2020", "DOM"],
      "module": "esnext",
      "moduleResolution": "bundler",
      "noFallthroughCasesInSwitch": true,
      "noImplicitReturns": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "outDir": "tempBuild",
      "rootDir": "src",
      "strict": true,
      "target": "ES2020"
   },
   "include": ["src"]
}
